classDiagram
    class Library {
        +add_book(book: Book)
        +register_user(user: User)
        +create_loan(book: Book, user: User)
    }

    class Book {
        +title: str
        +author: str
        +available: bool
        +mark_as_unavailable()
        +mark_as_available()
    }

    class User {
        +name: str
        +email: str
    }

    class Loan {
        +start_date: str
        +end_date: str
        +close_loan()
    }

    Library --> "0..*" Book : manages
    Library --> "0..*" User : registers
    Library --> "0..*" Loan : creates
    Loan --> "1" Book : references
    Loan --> "1" User : involves
